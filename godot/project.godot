; Clean public Godot client for Alter Emo.
; Generated files under .godot/ are intentionally ignored.
config_version=5

[application]

config/name="Alter Emo — AI Mirror"
run/main_scene="res://Main.tscn"

[display]

window/size/viewport_width=420
window/size/viewport_height=720
window/size/window_width_override=420
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.047, 0.078, 1)
